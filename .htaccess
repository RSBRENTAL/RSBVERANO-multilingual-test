RewriteEngine On

# --------------------------------------------
# 0) Endpoint de horarios antiguo -> endpoint canonico
# --------------------------------------------
# Sin QSD ni query de destino, Apache conserva la query original.
RewriteRule ^hours\.php$ /api/hours.php [R=301,L,NC]

# --------------------------------------------
# 0AA) Rutas inactivas retiradas: devolver 410 Gone
# --------------------------------------------
RewriteRule ^(inline-skate-classes|summer-camp-on-wheels-barcelona)/?$ - [G,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/(inline-skate-classes|summer-camp-on-wheels-barcelona)/?$ - [G,L,NC]

# --------------------------------------------
# 0A) Eliminar query interna de búsqueda antigua de WordPress (?s={search_term_string})
# --------------------------------------------
RewriteCond %{QUERY_STRING} (^|&)s=\{search_term_string\}(&|$) [NC]
RewriteRule ^(.*)$ https://rentalscooterbarcelona.com/$1? [R=301,L]

# --------------------------------------------
# 0B) AI discovery headers for AI-readable files
# --------------------------------------------
<IfModule mod_headers.c>
  Header add Link "<https://rentalscooterbarcelona.com/agents.md>; rel=\"alternate\"; type=\"text/markdown\""
  Header add Link "<https://rentalscooterbarcelona.com/llms.txt>; rel=\"alternate\"; type=\"text/plain\""
  Header add Link "<https://rentalscooterbarcelona.com/llms-full.txt>; rel=\"alternate\"; type=\"text/plain\""
  Header add Link "<https://rentalscooterbarcelona.com/services.json>; rel=\"alternate\"; type=\"application/json\""
  Header add Link "<https://rentalscooterbarcelona.com/prices.json>; rel=\"alternate\"; type=\"application/json\""
  Header add Link "<https://rentalscooterbarcelona.com/faq.json>; rel=\"alternate\"; type=\"application/json\""
  Header add Link "<https://rentalscooterbarcelona.com/multilingual-urls.json>; rel=\"alternate\"; type=\"application/json\""
</IfModule>

# --------------------------------------------
# 0C) Redirecciones de index.html e index numerados a URL canónica limpia
# --------------------------------------------
# Evita la cadena index3.html -> /cat/map/ -> /cat/location-contact/.
# Sin QSD ni query de destino, Apache conserva la query original.
RewriteRule ^cat/map/index3\.html$ https://rentalscooterbarcelona.com/cat/location-contact/ [R=301,L,NC]
RewriteRule ^index\.html$ https://rentalscooterbarcelona.com/ [R=301,L]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/index\.html$ https://rentalscooterbarcelona.com/$1/ [R=301,L]
RewriteRule ^(.+)/index\.html$ https://rentalscooterbarcelona.com/$1/ [R=301,L]
RewriteRule ^(.*/)?index[0-9]+\.html$ https://rentalscooterbarcelona.com/$1 [R=301,L]

# --------------------------------------------
# 0D) Archivos obsoletos detectados públicamente
# --------------------------------------------
RewriteRule ^index1\.html$ https://rentalscooterbarcelona.com/ [R=301,L]
RewriteRule ^courtesy\.html$ https://rentalscooterbarcelona.com/ [R=301,L]
RewriteRule ^offer\.html$ https://rentalscooterbarcelona.com/Prices/ [R=301,L]
RewriteRule ^fr/offer\.html$ https://rentalscooterbarcelona.com/fr/Prices/ [R=301,L]
RewriteRule ^fr/rentalbike\.html$ https://rentalscooterbarcelona.com/fr/bike/ [R=301,L]
RewriteRule ^rentalbike\.html$ https://rentalscooterbarcelona.com/bike/ [R=301,L]
RewriteRule ^es/es_sitemap\.xml$ https://rentalscooterbarcelona.com/sitemap-es.xml [R=301,L]
RewriteRule ^sitemap_es\.xml$ https://rentalscooterbarcelona.com/sitemap-es.xml [R=301,L]
RewriteRule ^sitemap_en\.xml$ https://rentalscooterbarcelona.com/sitemap-en.xml [R=301,L]

# --------------------------------------------
# 0E) Rutas anidadas falsas entre idiomas
# --------------------------------------------
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/(es|fr|it|de|nl|pt|cat|sv|pl)/?$ https://rentalscooterbarcelona.com/$1/ [R=301,L]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/(es|fr|it|de|nl|pt|cat|sv|pl)/.*$ https://rentalscooterbarcelona.com/$1/ [R=301,L]

# --------------------------------------------
# 0F) Redirecciones 301 de URLs antiguas detectadas por Google Search Console
# --------------------------------------------
# Gallery antigua -> home del idioma
RewriteRule ^gallery/?$ https://rentalscooterbarcelona.com/ [R=301,L,NC]
RewriteRule ^gallery/.*$ https://rentalscooterbarcelona.com/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/gallery/?$ https://rentalscooterbarcelona.com/$1/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/gallery/.*$ https://rentalscooterbarcelona.com/$1/ [R=301,L,NC]

# About/contact antiguos -> location-contact
RewriteRule ^about-us/?$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^about-us/.*$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^contact/?$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^contact/.*$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^contact-us/?$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^contact-us/.*$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/about-us/?$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/about-us/.*$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/contact/?$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/contact/.*$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/contact-us/?$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/contact-us/.*$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]

# Map/map-prices antiguos -> location-contact
RewriteRule ^map/?$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^map/.*$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^map-prices-information/?$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^map-prices-information/.*$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^map[[:space:]]+and[[:space:]]+prices/?$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^map[[:space:]]+and[[:space:]]+prices/index\.htm$ https://rentalscooterbarcelona.com/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/map/?$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/map/.*$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/map-prices-information/?$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/map-prices-information/.*$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/map[[:space:]]+and[[:space:]]+prices/?$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/map[[:space:]]+and[[:space:]]+prices/index\.htm$ https://rentalscooterbarcelona.com/$1/location-contact/ [R=301,L,NC]

# Conditions / groups antiguos -> Prices
RewriteRule ^conditions/?$ https://rentalscooterbarcelona.com/Prices/ [R=301,L,NC]
RewriteRule ^conditions/.*$ https://rentalscooterbarcelona.com/Prices/ [R=301,L,NC]
RewriteRule ^groups-rentals/?$ https://rentalscooterbarcelona.com/Prices/ [R=301,L,NC]
RewriteRule ^groups-rentals/.*$ https://rentalscooterbarcelona.com/Prices/ [R=301,L,NC]
RewriteRule ^group-rentals/?$ https://rentalscooterbarcelona.com/Prices/ [R=301,L,NC]
RewriteRule ^group-rentals/.*$ https://rentalscooterbarcelona.com/Prices/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/conditions/?$ https://rentalscooterbarcelona.com/$1/Prices/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/conditions/.*$ https://rentalscooterbarcelona.com/$1/Prices/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/groups-rentals/?$ https://rentalscooterbarcelona.com/$1/Prices/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/groups-rentals/.*$ https://rentalscooterbarcelona.com/$1/Prices/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/group-rentals/?$ https://rentalscooterbarcelona.com/$1/Prices/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/group-rentals/.*$ https://rentalscooterbarcelona.com/$1/Prices/ [R=301,L,NC]

# Blog rollerblades antiguo -> inline-skates actual
RewriteRule ^blog/rollerblades/?$ https://rentalscooterbarcelona.com/blog/inline-skates/ [R=301,L,NC]
RewriteRule ^blog/rollerblades/.*$ https://rentalscooterbarcelona.com/blog/inline-skates/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/blog/rollerblades/?$ https://rentalscooterbarcelona.com/$1/blog/inline-skates/ [R=301,L,NC]
RewriteRule ^(es|fr|it|de|nl|pt|cat|sv|pl)/blog/rollerblades/.*$ https://rentalscooterbarcelona.com/$1/blog/inline-skates/ [R=301,L,NC]

# --------------------------------------------
# 1) Forzar HTTPS + sin WWW (canonical en 1 salto cuando no hubo redirección anterior)
# --------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.rentalscooterbarcelona\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://rentalscooterbarcelona.com/$1 [R=301,L]

# --------------------------------------------
# 2) Permitir acceso directo a archivos HTML existentes que no sean obsoletos
# --------------------------------------------
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^(.+)\.html$ $1.html [L]

# --------------------------------------------
# 3) Compatibilidad con Nominalia + Varnish
# --------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header unset Pragma
    Header unset Cache-Control
  </FilesMatch>
</IfModule>

# --------------------------------------------
# 4) Cache estática
# --------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  <FilesMatch "^hours\.php$">
    ExpiresActive Off
  </FilesMatch>
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>
  <FilesMatch "^script\.js$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "^hours\.php$">
    Header unset Cache-Control
    Header always unset Cache-Control
    Header unset Expires
    Header always unset Expires
    Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header always set Pragma "no-cache"
    Header always set Expires "0"
  </FilesMatch>
</IfModule>

# --------------------------------------------
# 5) Seguridad básica
# --------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://ssl.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; frame-src 'self' https://www.google.com https://maps.google.com https://www.google.es; connect-src 'self' https://www.google-analytics.com https://region1.google-analytics.com https://region1.analytics.google.com https://www.googletagmanager.com https://stats.g.doubleclick.net https://www.google.com https://www.google.es; object-src 'none'; base-uri 'self'; form-action 'self' https://wa.me https://api.whatsapp.com; frame-ancestors 'none';"
  Header always set Strict-Transport-Security "max-age=31536000"
  <FilesMatch "^(yandex_.*\.html|BingSiteAuth\.xml|apple-domain-verification\.txt)$">
    Header always set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# --------------------------------------------
# 6) MIME webmanifest
# --------------------------------------------
AddType application/manifest+json .webmanifest
AddType text/markdown .md
AddType font/woff2 .woff2
